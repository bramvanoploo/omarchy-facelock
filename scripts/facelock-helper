#!/usr/bin/env bash
set -eo pipefail

check_installed() {
  if compgen -G "/var/lib/pacman/local/facelock-bin-*" >/dev/null 2>&1; then
    echo "facelock-bin"
    return 0
  fi
  if compgen -G "/var/lib/pacman/local/facelock-[0-9]*" >/dev/null 2>&1; then
    echo "facelock"
    return 0
  fi
  if command -v facelock >/dev/null 2>&1; then
    echo "facelock"
    return 0
  fi
  if pacman -Q facelock-bin >/dev/null 2>&1; then
    echo "facelock-bin"
    return 0
  fi
  if pacman -Q facelock >/dev/null 2>&1; then
    echo "facelock"
    return 0
  fi
  return 1
}

get_require_ir() {
  local cfg="/etc/facelock/config.toml"
  if [[ -r "$cfg" ]]; then
    local line val="true"
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%%#*}"
      line="${line#"${line%%[![:space:]]*}"}"
      line="${line%"${line##*[![:space:]]}"}"
      if [[ "$line" =~ ^require_ir[[:space:]]*=[[:space:]]*(true|false) ]]; then
        val="${BASH_REMATCH[1]}"
      fi
    done < "$cfg"
    echo "$val"
    return 0
  fi
  echo "true"
}

cmd_status() {
  local pkg
  if ! pkg=$(check_installed); then
    cat <<EOF
{
  "installed": false,
  "version": "",
  "package": "",
  "configured": false,
  "enrolled": false,
  "modelCount": 0,
  "lastUpdated": null,
  "daemonRunning": false,
  "hyprlockIntegrated": false,
  "requireIr": true
}
EOF
    return 0
  fi

  local version="unknown"
  if command -v facelock >/dev/null 2>&1; then
    read -r _ version < <(facelock --version 2>/dev/null || echo "facelock unknown")
    : "${version:=unknown}"
  fi

  local configured=false
  if [[ -f /etc/facelock/config.toml ]]; then
    configured=true
  fi

  local enrolled=false
  local model_count=0
  local last_updated="null"

  # facelock is-enrolled is an unprivileged read and never hangs
  local enroll_json
  enroll_json=$(timeout 1.5s facelock is-enrolled --json 2>/dev/null || true)
  if [[ -n "$enroll_json" ]]; then
    local raw_updated=""
    read -r enrolled model_count raw_updated < <(jq -r '[.enrolled // false, .models // 0, .updated // "null"] | @tsv' <<<"$enroll_json" 2>/dev/null || echo "false 0 null")
    if [[ -n "$raw_updated" && "$raw_updated" != "null" ]]; then
      last_updated="\"$raw_updated\""
    fi
    configured=true
  fi

  local daemon_running=false
  if systemctl is-active --quiet facelock 2>/dev/null; then
    daemon_running=true
  fi

  local hyprlock_integrated=false
  if facelock hyprlock status 2>/dev/null | grep -iq "enabled"; then
    hyprlock_integrated=true
  elif grep -qs "pam_facelock" /etc/pam.d/hyprlock 2>/dev/null; then
    hyprlock_integrated=true
  fi

  local require_ir
  require_ir=$(get_require_ir)

  cat <<EOF
{
  "installed": true,
  "version": "$version",
  "package": "$pkg",
  "configured": $configured,
  "enrolled": $enrolled,
  "modelCount": $model_count,
  "lastUpdated": $last_updated,
  "daemonRunning": $daemon_running,
  "hyprlockIntegrated": $hyprlock_integrated,
  "requireIr": $require_ir
}
EOF
}


launch_terminal() {
  local cmd="$*"
  if [[ -r "$(command -v omarchy-restart-gum 2>/dev/null)" ]]; then
    # shellcheck source=/dev/null
    source omarchy-restart-gum
  fi

  local presentation_script="omarchy-show-logo; $cmd; if (( \$? != 130 )); then omarchy-show-done; fi"

  # Ensure the stay_focused rule is loaded in the compositor
  hyprctl eval 'o.window({ class = "^(org.omarchy.terminal)$", title = "^(Omarchy Facelock.*)$" }, { stay_focused = true })' >/dev/null 2>&1 || true

  setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.terminal --title="Omarchy Facelock" -e bash -c "$presentation_script" >/dev/null 2>&1 &

  # Proactively focus the terminal as soon as it maps
  (
    for _ in {1..20}; do
      if hyprctl clients -j 2>/dev/null | jq -e '.[] | select(.class == "org.omarchy.terminal" and (.title | startswith("Omarchy Facelock")))' >/dev/null 2>&1; then
        hyprctl dispatch focuswindow "title:^Omarchy Facelock" >/dev/null 2>&1 || true
        break
      fi
      sleep 0.05
    done
  ) &
}

do_install() {
  echo "=== Facelock Installation ==="
  echo ""
  echo "Installing facelock-bin via yay..."
  if yay -S --noconfirm facelock-bin; then
    echo ""
    echo "✓ Installation complete."
    echo ""
    sleep 1
    do_setup
  else
    echo ""
    echo "Installation failed. Please check the output above."
    return 1
  fi
}

cmd_install() {
  local helper_path="$0"
  launch_terminal "bash '$helper_path' do-install"
}

do_uninstall() {
  echo "=== Uninstall Facelock ==="
  echo ""

  # 1. Clear all enrolled face models before starting the uninstall
  if command -v facelock >/dev/null 2>&1; then
    echo "Clearing all enrolled face models..."
    local target_user="${SUDO_USER:-${USER:-$(id -un)}}"
    sudo facelock clear -u "$target_user" -y 2>/dev/null || sudo facelock clear -y 2>/dev/null || true
    echo "✓ Enrolled face models cleared."
    echo ""
  fi

  # 2. Disable hyprlock if configured
  if command -v facelock >/dev/null 2>&1; then
    if facelock hyprlock status 2>/dev/null | grep -iq "enabled"; then
      echo "Disabling Facelock in Hyprlock..."
      sudo facelock hyprlock disable 2>/dev/null || true
    fi
  fi

  # 3. Stop and disable daemon if active
  if systemctl is-active --quiet facelock 2>/dev/null || systemctl is-enabled --quiet facelock 2>/dev/null; then
    echo "Stopping and disabling facelock daemon..."
    sudo systemctl disable --now facelock 2>/dev/null || true
  fi

  # 4. Remove Facelock from PAM service files
  if command -v facelock >/dev/null 2>&1; then
    echo "Removing Facelock PAM configuration..."
    local filename
    for file in /etc/pam.d/*; do
      if [[ -f "$file" ]] && (grep -qs "pam_facelock\.so" "$file" || sudo grep -qs "pam_facelock\.so" "$file"); then
        filename=$(basename "$file")
        echo "Removing PAM service: $filename..."
        sudo facelock pam remove --service "$filename" || true
      fi
    done
    echo "✓ Facelock removed from PAM service files."
  fi

  # 5. Uninstall facelock package
  echo ""
  echo "Uninstalling facelock-bin..."
  if pacman -Q facelock-bin >/dev/null 2>&1; then
    sudo pacman -Rns --noconfirm facelock-bin
  elif pacman -Q facelock >/dev/null 2>&1; then
    sudo pacman -Rns --noconfirm facelock
  fi

  # 6. Remove any remaining enrolled face data and database files
  echo ""
  echo "Removing any remaining enrolled face data..."
  sudo rm -rf /var/lib/facelock/enrolled /var/lib/facelock/facelock.db* 2>/dev/null || true
  rm -rf "${HOME}/.local/state/omarchy/facelock/pam-backups" 2>/dev/null || true
  echo "✓ Enrolled faces data removed."

  # 7. Clean up sudoers rule if present
  if [[ -f /etc/sudoers.d/facelock ]]; then
    sudo rm -f /etc/sudoers.d/facelock
  fi

  echo ""
  echo "✓ Facelock uninstalled successfully."
  sleep 2
}

cmd_uninstall() {
  local helper_path="$0"
  launch_terminal "bash '$helper_path' do-uninstall"
}

do_edit_config() {
  local cfg="/etc/facelock/config.toml"
  if [[ ! -f "$cfg" ]]; then
    sudo mkdir -p /etc/facelock
    sudo touch "$cfg"
    sudo chmod 0644 "$cfg"
  fi

  local default_editor="$HOME/.local/state/omarchy/defaults/editor"
  local ed=""
  [[ -f "$default_editor" ]] && read -r ed <"$default_editor"
  : "${ed:=${EDITOR:-nvim}}"
  [[ "$ed" == *"omarchy-launch-editor"* && -f "$default_editor" ]] && read -r ed <"$default_editor"

  echo "=== Edit Facelock Configuration ==="
  echo "File: $cfg"
  echo "Editor: $ed"
  echo ""

  case "${ed##*/}" in
    zed | zeditor)
      echo "Opening in Zed..."
      SUDO_EDITOR="zeditor --wait" sudoedit "$cfg"
      echo "✓ Configuration saved."
      sleep 1
      ;;
    code | codium | vscodium)
      echo "Opening in $ed..."
      SUDO_EDITOR="${ed} --wait" sudoedit "$cfg"
      echo "✓ Configuration saved."
      sleep 1
      ;;
    nvim | vim | nano | micro | hx | helix | fresh)
      sudo "$ed" "$cfg"
      ;;
    *)
      if command -v "$ed" >/dev/null 2>&1; then
        sudo "$ed" "$cfg" 2>/dev/null || SUDO_EDITOR="$ed" sudoedit "$cfg"
      else
        sudo nano "$cfg"
      fi
      ;;
  esac
}

cmd_edit_config() {
  local helper_path="$0"
  launch_terminal "bash '$helper_path' do-edit-config"
}

do_set_require_ir() {
  local new_val="$1"
  local cfg="/etc/facelock/config.toml"
  local sudo_cmd=""
  if [[ $EUID -ne 0 ]]; then
    sudo_cmd="sudo"
  fi

  if [[ ! -f "$cfg" ]]; then
    $sudo_cmd mkdir -p /etc/facelock
    printf '[security]\nrequire_ir = %s\n' "$new_val" | $sudo_cmd tee "$cfg" >/dev/null
    return $?
  fi

  if grep -qE '^[#[:space:]]*require_ir[[:space:]]*=' "$cfg"; then
    $sudo_cmd sed -i -E "s/^[#[:space:]]*require_ir[[:space:]]*=.*/require_ir = $new_val/" "$cfg"
  elif grep -qE '^\[security\]' "$cfg"; then
    $sudo_cmd sed -i -E "/^\[security\]/a require_ir = $new_val" "$cfg"
  else
    printf '\n[security]\nrequire_ir = %s\n' "$new_val" | $sudo_cmd tee -a "$cfg" >/dev/null
  fi

  if systemctl is-active --quiet facelock 2>/dev/null; then
    $sudo_cmd systemctl restart facelock 2>/dev/null || true
  fi
}

has_ir_camera() {
  # 1. Non-interactive check with facelock devices if sudo is cached or passwordless
  if command -v facelock >/dev/null 2>&1; then
    if sudo -n facelock devices 2>/dev/null | grep -q '\[IR\]'; then
      return 0
    fi
  fi

  # 2. Unprivileged check via v4l2-ctl for IR typical pixel formats (GREY, Y16, etc.)
  if command -v v4l2-ctl >/dev/null 2>&1; then
    for dev in /dev/video*; do
      [[ -e "$dev" ]] || continue
      if v4l2-ctl --list-formats -d "$dev" 2>/dev/null | grep -q -E "'(GREY|Y16|Y12|Y10|Z16)'"; then
        return 0
      fi
    done
  fi

  # 3. Check sysfs device names
  for name_file in /sys/class/video4linux/video*/name; do
    [[ -f "$name_file" ]] || continue
    if grep -iq -E "infrared|\bir\b" "$name_file" 2>/dev/null; then
      return 0
    fi
  done

  # 4. Interactive fallback via sudo facelock devices if facelock exists
  if command -v facelock >/dev/null 2>&1; then
    if sudo facelock devices 2>/dev/null | grep -q '\[IR\]'; then
      return 0
    fi
  fi

  return 1
}

do_setup() {
  echo "=== Checking Camera Capabilities ==="
  if has_ir_camera; then
    echo "✓ Infrared camera detected."
  else
    echo "Notice: No infrared camera detected on this computer."
    echo "Applying require_ir = false in /etc/facelock/config.toml..."
    do_set_require_ir "false"
    echo "✓ Disabled require_ir requirement for regular RGB camera."
  fi
  echo ""

  echo "=== Launching Facelock Setup Wizard ==="
  echo ""
  sudo facelock setup
}

cmd_setup() {
  local helper_path="$0"
  launch_terminal "bash '$helper_path' do-setup"
}

cmd_enroll() {
  local label="${1:-}"
  if [[ -n "$label" ]]; then
    launch_terminal "sudo facelock enroll -l \"$label\""
  else
    launch_terminal "sudo facelock enroll"
  fi
}

cmd_test() {
  launch_terminal "sudo facelock test"
}

cmd_preview() {
  launch_terminal "sudo facelock preview"
}

cmd_devices() {
  launch_terminal "sudo facelock devices"
}

cmd_models() {
  launch_terminal "sudo facelock list"
}

cmd_remove() {
  local id="$1"
  if [[ -n "$id" ]]; then
    launch_terminal "sudo facelock remove $id -y"
  fi
}

cmd_clear() {
  launch_terminal "sudo facelock clear -y"
}

cmd_hyprlock_toggle() {
  if facelock hyprlock status 2>/dev/null | grep -iq "enabled"; then
    facelock hyprlock disable >/dev/null 2>&1 || true
  else
    facelock hyprlock enable >/dev/null 2>&1 || true
  fi
}

cmd_require_ir_toggle() {
  local current
  current=$(get_require_ir)
  local new_val="true"
  if [[ "$current" == "true" ]]; then
    new_val="false"
  fi

  # Attempt passwordless sudo first
  if sudo -n true 2>/dev/null; then
    do_set_require_ir "$new_val"
    return $?
  fi

  # Desktop polkit agent prompt via pkexec
  if command -v pkexec >/dev/null 2>&1; then
    if pkexec bash -c "$(declare -f do_set_require_ir); do_set_require_ir $new_val" 2>/dev/null; then
      return 0
    fi
  fi

  # Terminal presentation fallback
  local helper_path="$0"
  launch_terminal "echo 'Updating require_ir in /etc/facelock/config.toml...'; sudo bash -c \"\$(declare -f do_set_require_ir); do_set_require_ir $new_val\" && echo '✓ require_ir set to $new_val' && sleep 1"
}

cmd_daemon_restart() {
  launch_terminal "sudo facelock daemon restart"
}

cmd_setup_sudoers() {
  launch_terminal "echo 'Configuring passwordless sudo for facelock...'; echo '$USER ALL=(ALL) NOPASSWD: /usr/bin/facelock' | sudo tee /etc/sudoers.d/facelock && sudo chmod 0440 /etc/sudoers.d/facelock && echo 'Done! Sudo confirmation is now automatic for facelock.'"
}

cmd_run() {
  local subcommand="$1"
  shift
  case "$subcommand" in
    status)
      launch_terminal "sudo facelock status"
      ;;
    tpm)
      launch_terminal "sudo facelock tpm status"
      ;;
    bench)
      launch_terminal "sudo facelock bench"
      ;;
    audit)
      launch_terminal "sudo facelock audit"
      ;;
    config)
      launch_terminal "sudo facelock config"
      ;;
    sudoers)
      cmd_setup_sudoers
      ;;
    *)
      launch_terminal "sudo facelock $*"
      ;;
  esac
}

case "${1:-status}" in
  status)
    cmd_status
    ;;
  devices)
    cmd_devices
    ;;
  models)
    cmd_models
    ;;
  install)
    cmd_install
    ;;
  do-install)
    do_install
    ;;
  has-ir-camera)
    has_ir_camera
    ;;
  setup)
    cmd_setup
    ;;
  do-setup)
    do_setup
    ;;
  enroll)
    shift
    cmd_enroll "$@"
    ;;
  test)
    cmd_test
    ;;
  preview)
    cmd_preview
    ;;
  remove)
    shift
    cmd_remove "$@"
    ;;
  clear)
    cmd_clear
    ;;
  hyprlock-toggle)
    cmd_hyprlock_toggle
    ;;
  daemon-restart)
    cmd_daemon_restart
    ;;
  setup-sudoers)
    cmd_setup_sudoers
    ;;
  uninstall)
    cmd_uninstall
    ;;
  do-uninstall)
    do_uninstall
    ;;
  edit-config)
    cmd_edit_config
    ;;
  do-edit-config)
    do_edit_config
    ;;
  require-ir-toggle)
    cmd_require_ir_toggle
    ;;
  set-require-ir)
    shift
    do_set_require_ir "$@"
    ;;
  run)
    shift
    cmd_run "$@"
    ;;
  *)
    echo "Unknown command: $1" >&2
    exit 1
    ;;
esac
