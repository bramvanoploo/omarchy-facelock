#!/usr/bin/env bash
set -eo pipefail

check_installed() {
  if pacman -Q facelock-bin >/dev/null 2>&1; then
    echo "facelock-bin"
    return 0
  fi
  if pacman -Q facelock >/dev/null 2>&1; then
    echo "facelock"
    return 0
  fi
  if command -v facelock >/dev/null 2>&1; then
    echo "facelock"
    return 0
  fi
  return 1
}

get_require_ir() {
  local cfg="/etc/facelock/config.toml"
  if [[ -f "$cfg" ]]; then
    local val
    val=$(grep -E '^[[:space:]]*require_ir[[:space:]]*=' "$cfg" 2>/dev/null | tail -n 1 | sed -E 's/^[[:space:]]*require_ir[[:space:]]*=[[:space:]]*//; s/[[:space:]]*#.*$//' | tr -d '[:space:]')
    if [[ "$val" == "false" ]]; then
      echo "false"
      return 0
    elif [[ "$val" == "true" ]]; then
      echo "true"
      return 0
    fi
  fi
  echo "true"
}

cmd_status() {
  local pkg
  if ! pkg=$(check_installed); then
    cat <<EOF
{
  "installed": false,
  "version": "",
  "package": "",
  "configured": false,
  "enrolled": false,
  "modelCount": 0,
  "lastUpdated": null,
  "daemonRunning": false,
  "hyprlockIntegrated": false,
  "requireIr": true
}
EOF
    return 0
  fi

  local version
  version=$(facelock --version 2>/dev/null | awk '{print $2}' || echo "unknown")

  local configured=false
  if [[ -f /etc/facelock/config.toml ]]; then
    configured=true
  fi

  local enrolled=false
  local model_count=0
  local last_updated="null"

  # facelock is-enrolled is an unprivileged read and never hangs
  local enroll_json
  enroll_json=$(timeout 1.5s facelock is-enrolled --json 2>/dev/null || true)
  if [[ -n "$enroll_json" ]]; then
    enrolled=$(jq -r '.enrolled // false' <<<"$enroll_json" 2>/dev/null || echo false)
    model_count=$(jq -r '.models // 0' <<<"$enroll_json" 2>/dev/null || echo 0)
    local raw_updated
    raw_updated=$(jq -r '.updated // empty' <<<"$enroll_json" 2>/dev/null || true)
    if [[ -n "$raw_updated" && "$raw_updated" != "null" ]]; then
      last_updated="\"$raw_updated\""
    fi
    configured=true
  fi

  local daemon_running=false
  if systemctl is-active --quiet facelock 2>/dev/null; then
    daemon_running=true
  fi

  local hyprlock_integrated=false
  if facelock hyprlock status 2>/dev/null | grep -iq "enabled"; then
    hyprlock_integrated=true
  elif grep -qs "pam_facelock" /etc/pam.d/hyprlock 2>/dev/null; then
    hyprlock_integrated=true
  fi

  local require_ir
  require_ir=$(get_require_ir)

  cat <<EOF
{
  "installed": true,
  "version": "$version",
  "package": "$pkg",
  "configured": $configured,
  "enrolled": $enrolled,
  "modelCount": $model_count,
  "lastUpdated": $last_updated,
  "daemonRunning": $daemon_running,
  "hyprlockIntegrated": $hyprlock_integrated,
  "requireIr": $require_ir
}
EOF
}

: "${BACKUP_BASE:=${HOME}/.local/state/omarchy/facelock/pam-backups}"

has_initial_pam_backup() {
  if [[ -d "${BACKUP_BASE}/initial" ]]; then
    return 0
  fi
  if [[ -d "${BACKUP_BASE}/pre-install" ]]; then
    return 0
  fi
  if find "$BACKUP_BASE" -mindepth 1 -maxdepth 1 -type d \( -name "pam-*-initial" -o -name "pam-*-pre-install" \) 2>/dev/null | grep -q .; then
    return 0
  fi
  return 1
}

backup_pam() {
  local tag="${1:-manual}"
  local timestamp
  timestamp=$(date +%Y%m%d_%H%M%S)
  local name="pam-${timestamp}-${tag}"
  local target="${BACKUP_BASE}/${name}"

  mkdir -p "$target"
  cp -a /etc/pam.d/. "$target/"
  local count
  count=$(find "$target" -type f | grep -v meta.json | wc -l)

  cat > "$target/meta.json" <<EOF
{
  "id": "$name",
  "tag": "$tag",
  "timestamp": "$timestamp",
  "date": "$(date -Iseconds)",
  "fileCount": $count
}
EOF

  if [[ "$tag" == "pre-install" || "$tag" == "initial" ]]; then
    if [[ ! -e "${BACKUP_BASE}/initial" ]]; then
      ln -sfn "$name" "${BACKUP_BASE}/initial"
    fi
    if [[ ! -e "${BACKUP_BASE}/pre-install" ]]; then
      ln -sfn "$name" "${BACKUP_BASE}/pre-install"
    fi
    if [[ "$tag" == "initial" ]]; then
      ln -sfn "$name" "${BACKUP_BASE}/initial"
    elif [[ "$tag" == "pre-install" ]]; then
      ln -sfn "$name" "${BACKUP_BASE}/pre-install"
    fi
  fi
  ln -sfn "$name" "${BACKUP_BASE}/latest"

  echo "$target"
}

launch_terminal() {
  local cmd="$*"
  if [[ -r "$(command -v omarchy-restart-gum 2>/dev/null)" ]]; then
    # shellcheck source=/dev/null
    source omarchy-restart-gum
  fi

  local presentation_script="omarchy-show-logo; $cmd; if (( \$? != 130 )); then omarchy-show-done; fi"

  # Ensure the stay_focused rule is loaded in the compositor
  hyprctl eval 'o.window({ class = "^(org.omarchy.terminal)$", title = "^(Omarchy Facelock.*)$" }, { stay_focused = true })' >/dev/null 2>&1 || true

  setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.terminal --title="Omarchy Facelock" -e bash -c "$presentation_script" >/dev/null 2>&1 &

  # Proactively focus the terminal as soon as it maps
  (
    for _ in {1..20}; do
      if hyprctl clients -j 2>/dev/null | jq -e '.[] | select(.class == "org.omarchy.terminal" and (.title | startswith("Omarchy Facelock")))' >/dev/null 2>&1; then
        hyprctl dispatch focuswindow "title:^Omarchy Facelock" >/dev/null 2>&1 || true
        break
      fi
      sleep 0.05
    done
  ) &
}

do_install() {
  echo "=== Facelock Installation ==="
  echo ""
  echo "Step 1/2: Backing up /etc/pam.d before installation..."
  local target
  target=$(backup_pam pre-install)
  echo "✓ PAM backup saved to: $target"
  echo ""
  echo "Step 2/2: Installing facelock-bin via yay..."
  if yay -S --noconfirm facelock-bin; then
    echo ""
    echo "✓ Installation complete."
    echo ""
    sleep 1
    do_setup
  else
    echo ""
    echo "Installation failed. Please check the output above."
    return 1
  fi
}

cmd_install() {
  local helper_path="$0"
  launch_terminal "bash '$helper_path' do-install"
}

cmd_backup_pam_user() {
  local helper_path="$0"
  launch_terminal "echo '=== Create PAM Backup ==='; echo ''; echo 'Backing up all files in /etc/pam.d...'; target=\$(bash '$helper_path' backup-pam manual) && echo \"✓ PAM backup created at: \$target\" && echo \"✓ Total \$(find \"\$target\" -type f | grep -v meta.json | wc -l) files backed up.\" && sleep 2"
}

do_restore_pam() {
  echo "=== Restore PAM Configuration ==="
  echo ""
  mkdir -p "$BACKUP_BASE"

  local backups=()
  while IFS= read -r dir; do
    [[ -n "$dir" && -d "$dir" ]] && backups+=("$(basename "$dir")")
  done < <(find "$BACKUP_BASE" -mindepth 1 -maxdepth 1 -type d -name "pam-*" 2>/dev/null | sort -r)

  if [[ ${#backups[@]} -eq 0 ]]; then
    echo "No PAM backups found in $BACKUP_BASE."
    echo ""
    read -rp "Press Enter to close..."
    return 1
  fi

  echo "Available PAM backups:"
  local chosen=""
  if command -v gum >/dev/null 2>&1; then
    chosen=$(gum choose --header="Select PAM backup to restore to /etc/pam.d:" "${backups[@]}" "Cancel")
    if [[ -z "$chosen" || "$chosen" == "Cancel" ]]; then
      echo "Restore cancelled."
      sleep 1
      return 0
    fi
  else
    PS3="Select backup number (or Cancel): "
    select b in "${backups[@]}" "Cancel"; do
      if [[ "$b" == "Cancel" || -z "$b" ]]; then
        echo "Restore cancelled."
        return 0
      fi
      chosen="$b"
      break
    done
  fi

  echo ""
  echo "Selected backup: $chosen"
  if command -v gum >/dev/null 2>&1; then
    if ! gum confirm "Are you sure you want to restore /etc/pam.d from $chosen?"; then
      echo "Restore cancelled."
      sleep 1
      return 0
    fi
  else
    read -rp "Are you sure you want to restore /etc/pam.d from $chosen? [y/N]: " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || { echo "Restore cancelled."; return 0; }
  fi

  echo ""
  echo "Restoring PAM configuration from $chosen (requires sudo)..."
  sudo cp -a "$BACKUP_BASE/$chosen/." /etc/pam.d/
  echo "✓ PAM configuration has been successfully restored from $chosen."
  sleep 2
}

cmd_restore_pam() {
  local helper_path="$0"
  launch_terminal "bash '$helper_path' do-restore-pam"
}

do_uninstall() {
  echo "=== Uninstall Facelock & Restore PAM ==="
  echo ""

  # 1. Disable hyprlock if configured
  if command -v facelock >/dev/null 2>&1; then
    if facelock hyprlock status 2>/dev/null | grep -iq "enabled"; then
      echo "Disabling Facelock in Hyprlock..."
      sudo facelock hyprlock disable 2>/dev/null || true
    fi
  fi

  # 2. Stop and disable daemon if active
  if systemctl is-active --quiet facelock 2>/dev/null || systemctl is-enabled --quiet facelock 2>/dev/null; then
    echo "Stopping and disabling facelock daemon..."
    sudo systemctl disable --now facelock 2>/dev/null || true
  fi

  # 3. Restore PAM backup if available
  local pam_restored=false
  local target_backup=""

  if [[ -d "$BACKUP_BASE/initial" ]]; then
    target_backup="$BACKUP_BASE/initial"
  elif [[ -d "$BACKUP_BASE/pre-install" ]]; then
    target_backup="$BACKUP_BASE/pre-install"
  elif [[ -d "$BACKUP_BASE/latest" ]]; then
    target_backup="$BACKUP_BASE/latest"
  else
    target_backup=$(find "$BACKUP_BASE" -mindepth 1 -maxdepth 1 -type d -name "pam-*" 2>/dev/null | sort -r | head -n 1)
  fi

  if [[ -n "$target_backup" && -d "$target_backup" ]]; then
    local bname
    bname=$(basename "$(readlink -f "$target_backup" 2>/dev/null || echo "$target_backup")")
    echo "Restoring PAM configuration from backup: $bname..."
    sudo cp -a "$target_backup/." /etc/pam.d/
    pam_restored=true
    echo "✓ Original PAM files restored."
  else
    echo "Notice: No PAM backup found in $BACKUP_BASE."
    echo "Cleaning up any remaining pam_facelock lines in /etc/pam.d/..."
    sudo sed -i '/pam_facelock\.so/d' /etc/pam.d/* 2>/dev/null || true
  fi

  # 4. Uninstall facelock package
  echo ""
  echo "Uninstalling facelock-bin..."
  if pacman -Q facelock-bin >/dev/null 2>&1; then
    sudo pacman -Rns --noconfirm facelock-bin
  elif pacman -Q facelock >/dev/null 2>&1; then
    sudo pacman -Rns --noconfirm facelock
  fi

  # 5. Clean up sudoers rule if present
  if [[ -f /etc/sudoers.d/facelock ]]; then
    sudo rm -f /etc/sudoers.d/facelock
  fi

  echo ""
  echo "✓ Facelock uninstalled successfully."
  if [[ "$pam_restored" == "true" ]]; then
    echo "✓ PAM configuration restored."
  fi
  sleep 2
}

cmd_uninstall() {
  local helper_path="$0"
  launch_terminal "bash '$helper_path' do-uninstall"
}

do_edit_config() {
  local cfg="/etc/facelock/config.toml"
  if [[ ! -f "$cfg" ]]; then
    sudo mkdir -p /etc/facelock
    sudo touch "$cfg"
    sudo chmod 0644 "$cfg"
  fi

  local default_editor="$HOME/.local/state/omarchy/defaults/editor"
  local ed=""
  [[ -f "$default_editor" ]] && read -r ed <"$default_editor"
  : "${ed:=${EDITOR:-nvim}}"
  [[ "$ed" == *"omarchy-launch-editor"* && -f "$default_editor" ]] && read -r ed <"$default_editor"

  echo "=== Edit Facelock Configuration ==="
  echo "File: $cfg"
  echo "Editor: $ed"
  echo ""

  case "${ed##*/}" in
    zed | zeditor)
      echo "Opening in Zed..."
      SUDO_EDITOR="zeditor --wait" sudoedit "$cfg"
      echo "✓ Configuration saved."
      sleep 1
      ;;
    code | codium | vscodium)
      echo "Opening in $ed..."
      SUDO_EDITOR="${ed} --wait" sudoedit "$cfg"
      echo "✓ Configuration saved."
      sleep 1
      ;;
    nvim | vim | nano | micro | hx | helix | fresh)
      sudo "$ed" "$cfg"
      ;;
    *)
      if command -v "$ed" >/dev/null 2>&1; then
        sudo "$ed" "$cfg" 2>/dev/null || SUDO_EDITOR="$ed" sudoedit "$cfg"
      else
        sudo nano "$cfg"
      fi
      ;;
  esac
}

cmd_edit_config() {
  local helper_path="$0"
  launch_terminal "bash '$helper_path' do-edit-config"
}

do_set_require_ir() {
  local new_val="$1"
  local cfg="/etc/facelock/config.toml"
  local sudo_cmd=""
  if [[ $EUID -ne 0 ]]; then
    sudo_cmd="sudo"
  fi

  if [[ ! -f "$cfg" ]]; then
    $sudo_cmd mkdir -p /etc/facelock
    printf '[security]\nrequire_ir = %s\n' "$new_val" | $sudo_cmd tee "$cfg" >/dev/null
    return $?
  fi

  if grep -qE '^[#[:space:]]*require_ir[[:space:]]*=' "$cfg"; then
    $sudo_cmd sed -i -E "s/^[#[:space:]]*require_ir[[:space:]]*=.*/require_ir = $new_val/" "$cfg"
  elif grep -qE '^\[security\]' "$cfg"; then
    $sudo_cmd sed -i -E "/^\[security\]/a require_ir = $new_val" "$cfg"
  else
    printf '\n[security]\nrequire_ir = %s\n' "$new_val" | $sudo_cmd tee -a "$cfg" >/dev/null
  fi

  if systemctl is-active --quiet facelock 2>/dev/null; then
    $sudo_cmd systemctl restart facelock 2>/dev/null || true
  fi
}

has_ir_camera() {
  # 1. Non-interactive check with facelock devices if sudo is cached or passwordless
  if command -v facelock >/dev/null 2>&1; then
    if sudo -n facelock devices 2>/dev/null | grep -q '\[IR\]'; then
      return 0
    fi
  fi

  # 2. Unprivileged check via v4l2-ctl for IR typical pixel formats (GREY, Y16, etc.)
  if command -v v4l2-ctl >/dev/null 2>&1; then
    for dev in /dev/video*; do
      [[ -e "$dev" ]] || continue
      if v4l2-ctl --list-formats -d "$dev" 2>/dev/null | grep -q -E "'(GREY|Y16|Y12|Y10|Z16)'"; then
        return 0
      fi
    done
  fi

  # 3. Check sysfs device names
  for name_file in /sys/class/video4linux/video*/name; do
    [[ -f "$name_file" ]] || continue
    if grep -iq -E "infrared|\bir\b" "$name_file" 2>/dev/null; then
      return 0
    fi
  done

  # 4. Interactive fallback via sudo facelock devices if facelock exists
  if command -v facelock >/dev/null 2>&1; then
    if sudo facelock devices 2>/dev/null | grep -q '\[IR\]'; then
      return 0
    fi
  fi

  return 1
}

do_setup() {
  if ! has_initial_pam_backup; then
    echo "=== Initial PAM Backup ==="
    echo "No initial backup of /etc/pam.d was found."
    echo "Creating initial backup before running setup wizard..."
    local target
    target=$(backup_pam initial)
    echo "✓ Initial PAM backup created at: $target"
    echo ""
  fi

  echo "=== Checking Camera Capabilities ==="
  if has_ir_camera; then
    echo "✓ Infrared camera detected."
  else
    echo "Notice: No infrared camera detected on this computer."
    echo "Applying require_ir = false in /etc/facelock/config.toml..."
    do_set_require_ir "false"
    echo "✓ Disabled require_ir requirement for regular RGB camera."
  fi
  echo ""

  echo "=== Launching Facelock Setup Wizard ==="
  echo ""
  sudo facelock setup
}

cmd_setup() {
  local helper_path="$0"
  launch_terminal "bash '$helper_path' do-setup"
}

cmd_enroll() {
  local label="${1:-}"
  if [[ -n "$label" ]]; then
    launch_terminal "sudo facelock enroll -l \"$label\""
  else
    launch_terminal "sudo facelock enroll"
  fi
}

cmd_test() {
  launch_terminal "sudo facelock test"
}

cmd_preview() {
  launch_terminal "sudo facelock preview"
}

cmd_devices() {
  launch_terminal "sudo facelock devices"
}

cmd_models() {
  launch_terminal "sudo facelock list"
}

cmd_remove() {
  local id="$1"
  if [[ -n "$id" ]]; then
    launch_terminal "sudo facelock remove $id -y"
  fi
}

cmd_clear() {
  launch_terminal "sudo facelock clear -y"
}

cmd_hyprlock_toggle() {
  if facelock hyprlock status 2>/dev/null | grep -iq "enabled"; then
    facelock hyprlock disable >/dev/null 2>&1 || true
  else
    facelock hyprlock enable >/dev/null 2>&1 || true
  fi
}

cmd_require_ir_toggle() {
  local current
  current=$(get_require_ir)
  local new_val="true"
  if [[ "$current" == "true" ]]; then
    new_val="false"
  fi

  # Attempt passwordless sudo first
  if sudo -n true 2>/dev/null; then
    do_set_require_ir "$new_val"
    return $?
  fi

  # Desktop polkit agent prompt via pkexec
  if command -v pkexec >/dev/null 2>&1; then
    if pkexec bash -c "$(declare -f do_set_require_ir); do_set_require_ir $new_val" 2>/dev/null; then
      return 0
    fi
  fi

  # Terminal presentation fallback
  local helper_path="$0"
  launch_terminal "echo 'Updating require_ir in /etc/facelock/config.toml...'; sudo bash -c \"\$(declare -f do_set_require_ir); do_set_require_ir $new_val\" && echo '✓ require_ir set to $new_val' && sleep 1"
}

cmd_daemon_restart() {
  launch_terminal "sudo facelock daemon restart"
}

cmd_setup_sudoers() {
  launch_terminal "echo 'Configuring passwordless sudo for facelock...'; echo '$USER ALL=(ALL) NOPASSWD: /usr/bin/facelock' | sudo tee /etc/sudoers.d/facelock && sudo chmod 0440 /etc/sudoers.d/facelock && echo 'Done! Sudo confirmation is now automatic for facelock.'"
}

cmd_run() {
  local subcommand="$1"
  shift
  case "$subcommand" in
    status)
      launch_terminal "sudo facelock status"
      ;;
    tpm)
      launch_terminal "sudo facelock tpm status"
      ;;
    bench)
      launch_terminal "sudo facelock bench"
      ;;
    audit)
      launch_terminal "sudo facelock audit"
      ;;
    config)
      launch_terminal "sudo facelock config"
      ;;
    sudoers)
      cmd_setup_sudoers
      ;;
    *)
      launch_terminal "sudo facelock $*"
      ;;
  esac
}

case "${1:-status}" in
  status)
    cmd_status
    ;;
  devices)
    cmd_devices
    ;;
  models)
    cmd_models
    ;;
  install)
    cmd_install
    ;;
  do-install)
    do_install
    ;;
  has-initial-backup)
    has_initial_pam_backup
    ;;
  has-ir-camera)
    has_ir_camera
    ;;
  setup)
    cmd_setup
    ;;
  do-setup)
    do_setup
    ;;
  enroll)
    shift
    cmd_enroll "$@"
    ;;
  test)
    cmd_test
    ;;
  preview)
    cmd_preview
    ;;
  remove)
    shift
    cmd_remove "$@"
    ;;
  clear)
    cmd_clear
    ;;
  hyprlock-toggle)
    cmd_hyprlock_toggle
    ;;
  daemon-restart)
    cmd_daemon_restart
    ;;
  setup-sudoers)
    cmd_setup_sudoers
    ;;
  backup-pam)
    shift
    backup_pam "$@"
    ;;
  backup-pam-user)
    cmd_backup_pam_user
    ;;
  restore-pam-menu)
    cmd_restore_pam
    ;;
  do-restore-pam)
    do_restore_pam
    ;;
  uninstall)
    cmd_uninstall
    ;;
  do-uninstall)
    do_uninstall
    ;;
  edit-config)
    cmd_edit_config
    ;;
  do-edit-config)
    do_edit_config
    ;;
  require-ir-toggle)
    cmd_require_ir_toggle
    ;;
  set-require-ir)
    shift
    do_set_require_ir "$@"
    ;;
  run)
    shift
    cmd_run "$@"
    ;;
  *)
    echo "Unknown command: $1" >&2
    exit 1
    ;;
esac
