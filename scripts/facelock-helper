#!/usr/bin/env bash
set -eo pipefail

check_installed() {
  if ! command -v facelock >/dev/null 2>&1 && [[ ! -x /usr/bin/facelock ]]; then
    return 1
  fi
  if pacman -Q facelock-bin >/dev/null 2>&1; then
    echo "facelock-bin"
    return 0
  fi
  if pacman -Q facelock >/dev/null 2>&1; then
    echo "facelock"
    return 0
  fi
  if pacman -Q facelock-git >/dev/null 2>&1; then
    echo "facelock-git"
    return 0
  fi
  echo "facelock"
  return 0
}

get_require_ir() {
  local cfg="/etc/facelock/config.toml"
  if [[ -r "$cfg" ]]; then
    local line val="true"
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%%#*}"
      line="${line#"${line%%[![:space:]]*}"}"
      line="${line%"${line##*[![:space:]]}"}"
      if [[ "$line" =~ ^require_ir[[:space:]]*=[[:space:]]*(true|false) ]]; then
        val="${BASH_REMATCH[1]}"
      fi
    done < "$cfg"
    echo "$val"
    return 0
  fi
  echo "true"
}

is_lock_explorer_installed() {
  if [[ -d "$HOME/.config/omarchy/plugins/io.github.sirjul1337.lock-explorer" ]]; then
    return 0
  fi
  if [[ -d "/usr/share/omarchy/plugins/io.github.sirjul1337.lock-explorer" ]]; then
    return 0
  fi
  if command -v omarchy >/dev/null 2>&1; then
    if omarchy plugin list 2>/dev/null | grep -q "^io\.github\.sirjul1337\.lock-explorer[[:space:]]"; then
      return 0
    fi
  fi
  return 1
}

is_lock_face_pam_installed() {
  [[ -f "/etc/pam.d/omarchy-lock-face" ]]
}

cmd_status() {
  local lock_explorer_installed=false
  if is_lock_explorer_installed; then
    lock_explorer_installed=true
  fi

  local lock_face_pam_exists=false
  if is_lock_face_pam_installed; then
    lock_face_pam_exists=true
  fi

  local has_ir=false
  if has_ir_camera; then
    has_ir=true
  fi

  local pkg
  if ! pkg=$(check_installed); then
    cat <<EOF
{
  "installed": false,
  "version": "",
  "package": "",
  "configured": false,
  "enrolled": false,
  "modelCount": 0,
  "lastUpdated": null,
  "daemonRunning": false,
  "hyprlockIntegrated": false,
  "requireIr": true,
  "hasIrCamera": $has_ir,
  "lockExplorerInstalled": $lock_explorer_installed,
  "lockFacePamExists": $lock_face_pam_exists
}
EOF
    return 0
  fi

  local version="unknown"
  if command -v facelock >/dev/null 2>&1; then
    version=$(facelock --version 2>/dev/null | awk '{print $2}' || echo "unknown")
    : "${version:=unknown}"
  fi

  local configured=false
  if [[ -f /etc/facelock/config.toml ]]; then
    configured=true
  fi

  local enrolled=false
  local model_count=0
  local last_updated="null"

  # facelock is-enrolled is an unprivileged read and never hangs
  local enroll_json
  enroll_json=$(timeout 1.5s facelock is-enrolled --json 2>/dev/null || true)
  if [[ -n "$enroll_json" ]]; then
    local raw_enrolled raw_models raw_updated
    raw_enrolled=$(jq -r '.enrolled // false' <<<"$enroll_json" 2>/dev/null || echo "false")
    raw_models=$(jq -r '.models // 0' <<<"$enroll_json" 2>/dev/null || echo "0")
    raw_updated=$(jq -r '.updated // empty' <<<"$enroll_json" 2>/dev/null || true)
    [[ "$raw_enrolled" == "true" ]] && enrolled=true
    [[ "$raw_models" =~ ^[0-9]+$ ]] && model_count="$raw_models"
    if [[ -n "$raw_updated" && "$raw_updated" != "null" ]]; then
      last_updated="\"$raw_updated\""
    fi
    configured=true
  fi

  local daemon_running=false
  if systemctl is-active --quiet facelock 2>/dev/null; then
    daemon_running=true
  fi

  local hyprlock_integrated=false
  if facelock hyprlock status 2>/dev/null | grep -iq "enabled"; then
    hyprlock_integrated=true
  elif grep -qs "pam_facelock" /etc/pam.d/hyprlock 2>/dev/null; then
    hyprlock_integrated=true
  fi

  local require_ir
  require_ir=$(get_require_ir)

  cat <<EOF
{
  "installed": true,
  "version": "$version",
  "package": "$pkg",
  "configured": $configured,
  "enrolled": $enrolled,
  "modelCount": $model_count,
  "lastUpdated": $last_updated,
  "daemonRunning": $daemon_running,
  "hyprlockIntegrated": $hyprlock_integrated,
  "requireIr": $require_ir,
  "hasIrCamera": $has_ir,
  "lockExplorerInstalled": $lock_explorer_installed,
  "lockFacePamExists": $lock_face_pam_exists
}
EOF
}


launch_terminal() {
  local cmd="$*"
  if [[ -r "$(command -v omarchy-restart-gum 2>/dev/null)" ]]; then
    # shellcheck source=/dev/null
    source omarchy-restart-gum
  fi

  local presentation_script="omarchy-show-logo; $cmd; if (( \$? != 130 )); then omarchy-show-done; fi"

  # Ensure the stay_focused rule is loaded in the compositor
  hyprctl eval 'o.window({ class = "^(org.omarchy.terminal)$", title = "^(Omarchy Facelock.*)$" }, { stay_focused = true })' >/dev/null 2>&1 || true

  setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.terminal --title="Omarchy Facelock" -e bash -c "$presentation_script" >/dev/null 2>&1 &

  # Proactively focus the terminal as soon as it maps
  (
    for _ in {1..20}; do
      if hyprctl clients -j 2>/dev/null | jq -e '.[] | select(.class == "org.omarchy.terminal" and (.title | startswith("Omarchy Facelock")))' >/dev/null 2>&1; then
        hyprctl dispatch focuswindow "title:^Omarchy Facelock" >/dev/null 2>&1 || true
        break
      fi
      sleep 0.05
    done
  ) &
}

do_install() {
  echo "=== Facelock Installation ==="
  echo ""
  echo "Installing facelock-bin via yay..."

  if yay -S --noconfirm facelock-bin; then
    echo ""
    echo "✓ Installation complete."
    echo ""
    sleep 1
    do_setup
    echo ""
    echo "Restarting Omarchy shell..."
    omarchy restart shell 2>/dev/null || true
  else
    echo ""
    echo "Installation failed. Please check the output above."
    return 1
  fi
}

cmd_install() {
  local helper_path="$0"
  launch_terminal "bash '$helper_path' do-install"
}

pam_add_facelock_to_system_auth() {
  local src="$1"
  local dst="$2"
  python3 -c '
import sys, re

with open(sys.argv[1], "r") as f:
    lines = f.readlines()

# 1. Find line with the highest success= value
max_val = -1
max_idx = -1
for i, line in enumerate(lines):
    m = re.search(r"success=(\d+)", line)
    if m:
        val = int(m.group(1))
        if val > max_val:
            max_val = val
            max_idx = i

if max_idx == -1:
    sys.stderr.write("Error: No success= entry found in PAM file.\n")
    sys.exit(1)

# 2. Place pam_facelock.so directly below the line with highest success=
new_line = "auth       [success=1 default=ignore]  pam_facelock.so\n"
lines.insert(max_idx + 1, new_line)

# 3. Look for all success= entries, grouped by section/chain, and make them incremental
# (top to bottom, high to low down to 1)
groups = []
current_group = []
for i, line in enumerate(lines):
    stripped = line.strip()
    has_success = bool(re.search(r"success=\d+", line))
    is_module = bool(re.match(r"^-?(auth|account|password|session)\b", stripped))
    if has_success:
        current_group.append(i)
    elif is_module:
        if current_group:
            groups.append(current_group)
            current_group = []
if current_group:
    groups.append(current_group)

for g in groups:
    count = len(g)
    for step, idx in enumerate(g):
        new_val = count - step
        lines[idx] = re.sub(r"success=\d+", f"success={new_val}", lines[idx])

with open(sys.argv[2], "w") as f:
    f.writelines(lines)
' "$src" "$dst"
}

pam_revert_facelock_from_system_auth() {
  local src="$1"
  local dst="$2"
  python3 -c '
import sys, re

with open(sys.argv[1], "r") as f:
    lines = [line for line in f.readlines() if "pam_facelock.so" not in line]

groups = []
current_group = []
for i, line in enumerate(lines):
    stripped = line.strip()
    has_success = bool(re.search(r"success=\d+", line))
    is_module = bool(re.match(r"^-?(auth|account|password|session)\b", stripped))
    if has_success:
        current_group.append(i)
    elif is_module:
        if current_group:
            groups.append(current_group)
            current_group = []
if current_group:
    groups.append(current_group)

for g in groups:
    count = len(g)
    for step, idx in enumerate(g):
        new_val = count - step
        lines[idx] = re.sub(r"success=\d+", f"success={new_val}", lines[idx])

with open(sys.argv[2], "w") as f:
    f.writelines(lines)
' "$src" "$dst"
}

do_install_lock_face_pam() {
  local target="/etc/pam.d/omarchy-lock-face"
  local sys_auth="/etc/pam.d/system-auth"
  echo "=== Install Lock Screen Support ==="
  echo ""

  # 1. Add facelock support for system PAM services
  echo "Configuring Facelock support for system-auth..."
  if grep -qs "pam_facelock\.so" "$sys_auth"; then
    echo "✓ Facelock line already present in $sys_auth."
  else
    local tmp_auth
    tmp_auth=$(mktemp)
    if pam_add_facelock_to_system_auth "$sys_auth" "$tmp_auth"; then
      sudo cp "$tmp_auth" "$sys_auth"
      sudo chmod 0644 "$sys_auth"
      sudo chown root:root "$sys_auth"
      rm -f "$tmp_auth"
      echo "✓ Configured $sys_auth."
    else
      rm -f "$tmp_auth"
      echo "Warning: Could not configure $sys_auth."
    fi
  fi
  sudo rm -f /etc/pam.d/system-auth.facelock-backup 2>/dev/null || true

  echo "Configuring Facelock support for system-login..."
  if grep -qs "pam_facelock\.so" /etc/pam.d/system-login; then
    echo "✓ Facelock line already present in /etc/pam.d/system-login."
  elif sudo facelock pam add --service system-login --allow-sensitive --yes; then
    echo "✓ Facelock added to system-login."
  else
    echo "Warning: Could not configure system-login with facelock."
  fi

  echo "Configuring Facelock support for system-local-login..."
  if grep -qs "pam_facelock\.so" /etc/pam.d/system-local-login; then
    echo "✓ Facelock line already present in /etc/pam.d/system-local-login."
  elif sudo facelock pam add --service system-local-login --yes; then
    echo "✓ Facelock added to system-local-login."
  else
    echo "Warning: Could not configure system-local-login with facelock."
  fi
  echo ""

  # 2. Create /etc/pam.d/omarchy-lock-face
  echo "Setting up /etc/pam.d/omarchy-lock-face for Lock Screen Explorer..."
  local tmp
  tmp=$(mktemp)
  trap 'rm -f "$tmp"' EXIT
  cat << 'EOF' > "$tmp"
#%PAM-1.0

-auth      sufficient                  pam_facelock.so
auth       required                    pam_deny.so
account    include                     system-local-login
EOF

  local ref_file="/etc/pam.d/sudo"
  [[ ! -f "$ref_file" ]] && ref_file="/etc/pam.d/other"
  [[ ! -f "$ref_file" ]] && ref_file="/etc/pam.d/system-auth"

  local perms="644"
  local owner="root"
  local group="root"

  if [[ -f "$ref_file" ]]; then
    perms=$(stat -c "%a" "$ref_file" 2>/dev/null || echo "644")
    owner=$(stat -c "%U" "$ref_file" 2>/dev/null || echo "root")
    group=$(stat -c "%G" "$ref_file" 2>/dev/null || echo "root")
  fi

  chmod "$perms" "$tmp"
  if sudo cp "$tmp" "$target"; then
    sudo chown "$owner:$group" "$target" 2>/dev/null || true
    sudo chmod "$perms" "$target" 2>/dev/null || true
    rm -f "$tmp"
    echo ""
    echo "✓ Successfully installed $target"
    echo "  Owner: $owner:$group"
    echo "  Permissions: $perms"
    echo ""
    echo "Face unlock is now supported with the Lock Screen Explorer plugin."
    sleep 2
    return 0
  else
    rm -f "$tmp"
    echo ""
    echo "Error: Failed to install $target"
    sleep 2
    return 1
  fi
}

cmd_install_lock_face_pam() {
  local helper_path="$0"
  launch_terminal "bash '$helper_path' do-install-lock-face-pam"
}

do_remove_lock_face_pam() {
  local target="/etc/pam.d/omarchy-lock-face"
  local sys_auth="/etc/pam.d/system-auth"
  echo "=== Remove Lock Screen Support ==="
  echo ""

  # 1. Revert system-auth PAM file
  if grep -qs "pam_facelock\.so" "$sys_auth"; then
    echo "Reverting Facelock in $sys_auth..."
    local tmp_auth
    tmp_auth=$(mktemp)
    if pam_revert_facelock_from_system_auth "$sys_auth" "$tmp_auth"; then
      sudo cp "$tmp_auth" "$sys_auth"
      sudo chmod 0644 "$sys_auth"
      sudo chown root:root "$sys_auth"
      rm -f "$tmp_auth"
      echo "✓ Reverted $sys_auth."
    else
      rm -f "$tmp_auth"
      echo "Warning: Could not revert $sys_auth."
    fi
  fi
  sudo rm -f /etc/pam.d/system-auth.facelock-backup 2>/dev/null || true

  # 2. Remove facelock from other system PAM services
  if command -v facelock >/dev/null 2>&1; then
    echo "Removing Facelock from system PAM services..."
    sudo facelock pam remove --service system-login || true
    sudo facelock pam remove --service system-local-login || true
    echo "✓ Removed Facelock from system PAM services."
    echo ""
  fi

  # 3. Remove /etc/pam.d/omarchy-lock-face
  if [[ -f "$target" ]]; then
    echo "Removing $target..."
    if sudo rm -f "$target"; then
      echo "✓ Lock screen support removed ($target deleted)."
      sleep 1
      return 0
    else
      echo "Error: Failed to remove $target"
      sleep 2
      return 1
    fi
  else
    echo "Notice: $target does not exist."
    sleep 1
    return 0
  fi
}

cmd_remove_lock_face_pam() {
  local helper_path="$0"
  launch_terminal "bash '$helper_path' do-remove-lock-face-pam"
}

do_uninstall() {
  echo "=== Uninstall Facelock ==="
  echo ""

  # 1. Clear all enrolled face models before starting the uninstall
  if command -v facelock >/dev/null 2>&1; then
    echo "Clearing all enrolled face models..."
    local target_user="${SUDO_USER:-${USER:-$(id -un)}}"
    sudo facelock clear -u "$target_user" -y 2>/dev/null || sudo facelock clear -y 2>/dev/null || true
    echo "✓ Enrolled face models cleared."
    echo ""
  fi

  # 2. Disable hyprlock if configured
  if command -v facelock >/dev/null 2>&1; then
    if facelock hyprlock status 2>/dev/null | grep -iq "enabled"; then
      echo "Disabling Facelock in Hyprlock..."
      sudo facelock hyprlock disable 2>/dev/null || true
    fi
  fi

  # 3. Stop and disable daemon if active
  if systemctl is-active --quiet facelock 2>/dev/null || systemctl is-enabled --quiet facelock 2>/dev/null; then
    echo "Stopping and disabling facelock daemon..."
    sudo systemctl disable --now facelock 2>/dev/null || true
  fi

  # 4. Remove Facelock from PAM service files
  local sys_auth="/etc/pam.d/system-auth"
  if grep -qs "pam_facelock\.so" "$sys_auth"; then
    echo "Reverting Facelock in $sys_auth..."
    local tmp_auth
    tmp_auth=$(mktemp)
    if pam_revert_facelock_from_system_auth "$sys_auth" "$tmp_auth"; then
      sudo cp "$tmp_auth" "$sys_auth"
      sudo chmod 0644 "$sys_auth"
      sudo chown root:root "$sys_auth"
      rm -f "$tmp_auth"
      echo "✓ Reverted $sys_auth."
    fi
  fi
  sudo rm -f /etc/pam.d/system-auth.facelock-backup 2>/dev/null || true

  if [[ -f /etc/pam.d/omarchy-lock-face ]]; then
    sudo rm -f /etc/pam.d/omarchy-lock-face 2>/dev/null || true
  fi

  if command -v facelock >/dev/null 2>&1; then
    echo "Removing Facelock PAM configuration..."
    local filename
    for file in /etc/pam.d/*; do
      if [[ -f "$file" ]] && grep -qs "pam_facelock\.so" "$file"; then
        filename=$(basename "$file")
        echo "Removing PAM service: $filename..."
        sudo facelock pam remove --service "$filename" || true
      fi
    done
    echo "✓ Facelock removed from PAM service files."
  fi

  # 5. Uninstall facelock package
  echo ""
  echo "Uninstalling facelock-bin..."
  if pacman -Q facelock-bin >/dev/null 2>&1; then
    sudo pacman -Rns --noconfirm facelock-bin
  elif pacman -Q facelock >/dev/null 2>&1; then
    sudo pacman -Rns --noconfirm facelock
  elif pacman -Q facelock-git >/dev/null 2>&1; then
    sudo pacman -Rns --noconfirm facelock-git
  fi

  # 6. Remove any remaining enrolled face data and database files
  echo ""
  echo "Removing any remaining enrolled face data..."
  sudo rm -rf /var/lib/facelock/enrolled /var/lib/facelock/facelock.db* 2>/dev/null || true
  echo "✓ Enrolled faces data removed."

  echo ""
  echo "✓ Facelock uninstalled successfully."
  sleep 2
}

cmd_uninstall() {
  local helper_path="$0"
  launch_terminal "bash '$helper_path' do-uninstall"
}

do_edit_config() {
  local cfg="/etc/facelock/config.toml"
  if [[ ! -f "$cfg" ]]; then
    sudo mkdir -p /etc/facelock
    sudo touch "$cfg"
    sudo chmod 0644 "$cfg"
  fi

  local default_editor="$HOME/.local/state/omarchy/defaults/editor"
  local ed=""
  [[ -f "$default_editor" ]] && read -r ed <"$default_editor"
  : "${ed:=${EDITOR:-nvim}}"
  [[ "$ed" == *"omarchy-launch-editor"* && -f "$default_editor" ]] && read -r ed <"$default_editor"

  echo "=== Edit Facelock Configuration ==="
  echo "File: $cfg"
  echo "Editor: $ed"
  echo ""

  case "${ed##*/}" in
    zed | zeditor)
      echo "Opening in Zed..."
      SUDO_EDITOR="zeditor --wait" sudoedit "$cfg"
      echo "✓ Configuration saved."
      sleep 1
      ;;
    code | codium | vscodium)
      echo "Opening in $ed..."
      SUDO_EDITOR="${ed} --wait" sudoedit "$cfg"
      echo "✓ Configuration saved."
      sleep 1
      ;;
    nvim | vim | nano | micro | hx | helix | fresh)
      sudo "$ed" "$cfg"
      ;;
    *)
      if command -v "$ed" >/dev/null 2>&1; then
        sudo "$ed" "$cfg" 2>/dev/null || SUDO_EDITOR="$ed" sudoedit "$cfg"
      else
        sudo nano "$cfg"
      fi
      ;;
  esac
}

cmd_edit_config() {
  local helper_path="$0"
  launch_terminal "bash '$helper_path' do-edit-config"
}

do_set_require_ir() {
  local new_val="$1"
  local cfg="/etc/facelock/config.toml"
  local sudo_cmd=""
  if [[ $EUID -ne 0 ]]; then
    sudo_cmd="sudo"
  fi

  # Don't change require_ir to true if already true or commented out (enabled by default)
  if [[ "$new_val" == "true" ]]; then
    if [[ ! -f "$cfg" ]] || ! grep -qE '^[[:space:]]*require_ir[[:space:]]*=[[:space:]]*false' "$cfg"; then
      return 0
    fi
  fi

  if [[ ! -f "$cfg" ]]; then
    $sudo_cmd mkdir -p /etc/facelock
    printf '[security]\nrequire_ir = %s\n' "$new_val" | $sudo_cmd tee "$cfg" >/dev/null
    return $?
  fi

  if [[ "$new_val" == "true" ]]; then
    # Comment out or reset require_ir back to default
    if grep -qE '^[[:space:]]*require_ir[[:space:]]*=' "$cfg"; then
      $sudo_cmd sed -i -E "s/^[[:space:]]*require_ir[[:space:]]*=.*/# require_ir = true/" "$cfg"
    fi
  else
    if grep -qE '^[#[:space:]]*require_ir[[:space:]]*=' "$cfg"; then
      $sudo_cmd sed -i -E "s/^[#[:space:]]*require_ir[[:space:]]*=.*/require_ir = false/" "$cfg"
    elif grep -qE '^\[security\]' "$cfg"; then
      $sudo_cmd sed -i -E "/^\[security\]/a require_ir = false" "$cfg"
    else
      printf '\n[security]\nrequire_ir = false\n' | $sudo_cmd tee -a "$cfg" >/dev/null
    fi
  fi

  if systemctl is-active --quiet facelock 2>/dev/null; then
    $sudo_cmd systemctl restart facelock 2>/dev/null || true
  fi
}

has_ir_camera() {
  # 1. Unprivileged check via v4l2-ctl for IR typical pixel formats (GREY, Y16, etc.)
  if command -v v4l2-ctl >/dev/null 2>&1; then
    for dev in /dev/video*; do
      [[ -e "$dev" ]] || continue
      if v4l2-ctl --list-formats -d "$dev" 2>/dev/null | grep -q -E "'(GREY|Y16|Y12|Y10|Z16)'"; then
        return 0
      fi
    done
  fi

  # 2. Check sysfs device names
  for name_file in /sys/class/video4linux/video*/name; do
    [[ -f "$name_file" ]] || continue
    if grep -iq -E "infrared|\bir\b" "$name_file" 2>/dev/null; then
      return 0
    fi
  done

  # 3. Interactive fallback via sudo facelock devices if facelock exists and in terminal
  if [[ -t 0 ]] && command -v facelock >/dev/null 2>&1; then
    if sudo facelock devices 2>/dev/null | grep -q '\[IR\]'; then
      return 0
    fi
  fi

  return 1
}

do_setup() {
  echo "=== Checking Camera Capabilities ==="
  if has_ir_camera; then
    echo "✓ Infrared camera detected."
  else
    echo "Notice: No infrared camera detected on this computer."
    echo ""
    echo "Using a regular (non-IR) camera is less secure because it lacks"
    echo "infrared depth and liveness detection, making it more vulnerable"
    echo "to presentation attacks (such as photos or digital screens)."
    echo ""

    local allow_non_ir=false
    if command -v gum >/dev/null 2>&1; then
      if gum confirm "Are you sure you want to use a non-IR camera for face unlock?" \
          --affirmative="Understood" \
          --negative="Cancel"; then
        allow_non_ir=true
      fi
    else
      read -r -p "Are you sure you want to use a non-IR camera for face unlock? [y/N]: " reply
      if [[ "$reply" =~ ^[Yy]$ ]]; then
        allow_non_ir=true
      fi
    fi

    if [[ "$allow_non_ir" == "true" ]]; then
      echo ""
      echo "Applying require_ir = false in /etc/facelock/config.toml..."
      do_set_require_ir "false"
      echo "✓ Disabled require_ir requirement for regular RGB camera."
    else
      echo ""
      do_set_require_ir "true"
      echo "Notice: require_ir remains enabled."
      echo "It will not be possible to use face unlock since there is no camera available to use."
      echo ""
      sleep 3
      return 1
    fi
  fi
  echo ""

  echo "=== Launching Facelock Setup Wizard ==="
  echo ""
  sudo facelock setup
}

cmd_setup() {
  local helper_path="$0"
  launch_terminal "bash '$helper_path' do-setup"
}

cmd_enroll() {
  local label="${1:-}"
  if [[ -n "$label" ]]; then
    launch_terminal "sudo facelock enroll -l \"$label\""
  else
    launch_terminal "sudo facelock enroll"
  fi
}

cmd_test() {
  launch_terminal "sudo facelock test"
}

cmd_preview() {
  launch_terminal "sudo facelock preview"
}

cmd_devices() {
  launch_terminal "sudo facelock devices"
}

cmd_models() {
  launch_terminal "sudo facelock list"
}

cmd_remove() {
  local id="$1"
  if [[ -n "$id" ]]; then
    launch_terminal "sudo facelock remove $id -y"
  fi
}

cmd_clear() {
  launch_terminal "sudo facelock clear -y"
}

cmd_hyprlock_toggle() {
  if facelock hyprlock status 2>/dev/null | grep -iq "enabled"; then
    facelock hyprlock disable >/dev/null 2>&1 || true
  else
    facelock hyprlock enable >/dev/null 2>&1 || true
  fi
}

cmd_set_require_ir() {
  local new_val="${1:-true}"
  local cfg="/etc/facelock/config.toml"

  # Don't change require_ir to true if already true or commented out (enabled by default)
  if [[ "$new_val" == "true" ]]; then
    if [[ ! -f "$cfg" ]] || ! grep -qE '^[[:space:]]*require_ir[[:space:]]*=[[:space:]]*false' "$cfg"; then
      return 0
    fi
  fi

  # Apply directly if running as root
  if [[ $EUID -eq 0 ]]; then
    do_set_require_ir "$new_val"
    return $?
  fi

  # Desktop polkit agent prompt via pkexec
  if command -v pkexec >/dev/null 2>&1; then
    if pkexec bash -c "$(declare -f do_set_require_ir); do_set_require_ir $new_val" 2>/dev/null; then
      return 0
    fi
  fi

  # Terminal presentation fallback
  local helper_path="$0"
  launch_terminal "echo 'Updating require_ir in /etc/facelock/config.toml...'; sudo bash -c \"\$(declare -f do_set_require_ir); do_set_require_ir $new_val\" && echo '✓ require_ir set to $new_val' && sleep 1"
}

cmd_require_ir_toggle() {
  local current
  current=$(get_require_ir)
  local new_val="true"
  if [[ "$current" == "true" ]]; then
    new_val="false"
  fi
  cmd_set_require_ir "$new_val"
}

cmd_daemon_restart() {
  launch_terminal "sudo facelock daemon restart"
}

cmd_run() {
  local subcommand="$1"
  shift
  case "$subcommand" in
    status)
      launch_terminal "sudo facelock status"
      ;;
    tpm)
      launch_terminal "sudo facelock tpm status"
      ;;
    bench)
      launch_terminal "sudo facelock bench"
      ;;
    audit)
      launch_terminal "sudo facelock audit"
      ;;
    config)
      launch_terminal "sudo facelock config"
      ;;
    *)
      launch_terminal "sudo facelock $*"
      ;;
  esac
}

case "${1:-status}" in
  status)
    cmd_status
    ;;
  devices)
    cmd_devices
    ;;
  models)
    cmd_models
    ;;
  install)
    cmd_install
    ;;
  do-install)
    do_install
    ;;
  has-ir-camera)
    has_ir_camera
    ;;
  setup)
    cmd_setup
    ;;
  do-setup)
    do_setup
    ;;
  enroll)
    shift
    cmd_enroll "$@"
    ;;
  test)
    cmd_test
    ;;
  preview)
    cmd_preview
    ;;
  remove)
    shift
    cmd_remove "$@"
    ;;
  clear)
    cmd_clear
    ;;
  hyprlock-toggle)
    cmd_hyprlock_toggle
    ;;
  daemon-restart)
    cmd_daemon_restart
    ;;
  uninstall)
    cmd_uninstall
    ;;
  do-uninstall)
    do_uninstall
    ;;
  install-lock-face-pam)
    cmd_install_lock_face_pam
    ;;
  do-install-lock-face-pam)
    do_install_lock_face_pam
    ;;
  remove-lock-face-pam)
    cmd_remove_lock_face_pam
    ;;
  do-remove-lock-face-pam)
    do_remove_lock_face_pam
    ;;
  edit-config)
    cmd_edit_config
    ;;
  do-edit-config)
    do_edit_config
    ;;
  require-ir-toggle)
    cmd_require_ir_toggle
    ;;
  set-require-ir)
    shift
    cmd_set_require_ir "$@"
    ;;
  do-set-require-ir)
    shift
    do_set_require_ir "$@"
    ;;
  run)
    shift
    cmd_run "$@"
    ;;
  *)
    echo "Unknown command: $1" >&2
    exit 1
    ;;
esac
